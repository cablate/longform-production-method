{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cablate/longform-production-method/schemas/source-packet.schema.json",
  "title": "Source Packet",
  "type": "object",
  "required": ["schema_version", "id", "kind", "content", "provenance", "public_boundary"],
  "properties": {
    "schema_version": {"const": "source-packet/v1"},
    "id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "content": {"type": "string", "minLength": 1},
    "context": {"type": "string"},
    "provenance": {
      "type": "object",
      "required": ["locator", "completeness"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
        "completeness": {"enum": ["complete", "partial", "not_fetched"]}
      },
      "additionalProperties": true
    },
    "public_boundary": {"type": "array", "items": {"type": "string"}},
    "upstream_signals": {"type": "object"}
  },
  "additionalProperties": true
}
